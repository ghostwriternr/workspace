{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workspace",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "WorkspaceObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceObject"] }
  ],
  "r2_buckets": [
    { "binding": "WORKSPACE_BLOBS", "bucket_name": "workspace-blobs" }
  ]
}
