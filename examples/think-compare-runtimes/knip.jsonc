{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["shared/**/*.test.ts", "src/**/*.test.ts", "src/**/*.test.tsx", "worker/**/*.test.ts"],
  "project": ["shared/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "worker/**/*.ts"],
  "ignoreDependencies": [
    // `cloudflare:workers` is a Workers runtime/vitest-pool virtual module,
    // not an npm package named `cloudflare`.
    "cloudflare"
  ],
  "rules": {
    "exports": "error",
    "types": "error"
  }
}
