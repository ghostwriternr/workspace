{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workspace-photo-agent-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "ai": { "binding": "AI" },
  "vars": {
    "SANDBOX_TRANSPORT": "rpc"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*", "/health"]
  },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "workspace-photo-agent-demo", "remote": true }],
  "worker_loaders": [{ "binding": "DYNAMIC_WORKERS" }],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PhotoAgent", "class_name": "PhotoAgent" },
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "WORKSPACE_OBJECTS", "class_name": "WorkspaceObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhotoAgent", "Sandbox", "WorkspaceObject"] }
  ],
  "observability": { "enabled": true },
  "upload_source_maps": true
}
