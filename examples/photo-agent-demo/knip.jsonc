{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["test/**/*.test.ts", "test/worker.ts"],
  "project": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "vitest*.config.ts"],
  "ignoreDependencies": [
    "cloudflare"
  ],
  "rules": {
    // The example is an app, not a package API surface. Keep exported symbols
    // intentional while preserving the Workspace prototype imports above.
    "exports": "error",
    "types": "error"
  }
}
