{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workspace-photo-agent-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "vars": {
    "SANDBOX_TRANSPORT": "rpc"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*", "/health"]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PhotoAgent", "class_name": "PhotoAgent" },
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "WORKSPACES", "class_name": "WorkspaceObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhotoAgent", "Sandbox", "WorkspaceObject"] }
  ],
  "r2_buckets": [
    { "binding": "WORKSPACE_BLOBS", "bucket_name": "workspace-photo-agent-demo-blobs" }
  ],
  "observability": { "enabled": true },
  "upload_source_maps": true
}
